# Scrabble Crossword Generator Configuration

# The port where the app container listens (internal)
PORT=3000

# The port exposed on the host machine
HOST_PORT=3000

# Container names
APP_CONTAINER_NAME=scrabble-crossword-generator
CLOUDFLARED_CONTAINER_NAME=cloudflared-tunnel

# Docker restart policy for the services
RESTART_POLICY=unless-stopped

# Custom paths to mount volumes (relative or absolute)
BOARD_TEXTURES_PATH=./public/textures/board
TILES_TEXTURES_PATH=./public/textures/tiles
TITLE_TEXTURES_PATH=./public/textures/title
FONT_TILES_PATH=./public/font_tiles
FONTS_TITLES_PATH=./dist/fonts_titles

# Cloudflare Tunnel Configuration
# Replace with your actual Cloudflare Tunnel token
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here
